# Copy this file to .env and fill in real values. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED if users will save Gemini API keys (they are encrypted with a key derived from this).
SECRET_KEY=change-me

# Optional. Defaults to instance/dukaanlens.db
# DATABASE_URL=sqlite:///dukaanlens.db

# Optional. Each user can add their own Gemini key in Settings. This is a fallback for
# users who have not, e.g. on a private single-owner install.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
